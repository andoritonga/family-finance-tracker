# Google Service Account Credentials
# Option 1: Paste the entire JSON key content here (single line, escape newlines)
# GOOGLE_SERVICE_ACCOUNT_KEY='{"type":"service_account","project_id":"...","private_key":"...","client_email":"...","...":"..."}'

# Option 2: Path to the JSON key file
GOOGLE_SERVICE_ACCOUNT_KEY_PATH=./service-account-key.json

# Google Spreadsheet ID (found in URL: https://docs.google.com/spreadsheets/d/<SPREADSHEET_ID>/edit)
GOOGLE_SPREADSHEET_ID=your_google_spreadsheet_id_here
